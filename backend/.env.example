# Local AI Harness - Backend Configuration
# Copy this file to .env and modify as needed

# Server Configuration
AI_HOST=127.0.0.1
AI_PORT=3000

# CORS Origins (comma-separated)
AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request Timeout (milliseconds)
AI_REQUEST_TIMEOUT_MS=30000

# Maximum Upload Size (megabytes)
AI_MAX_UPLOAD_SIZE_MB=10

# Upload Directory
AI_UPLOAD_DIR=./uploads

# Default Provider Timeout (milliseconds)
AI_DEFAULT_PROVIDER_TIMEOUT_MS=120000

# Environment (development, production, test)
AI_ENVIRONMENT=development
